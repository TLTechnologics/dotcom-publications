# ==============================================================================
# DOTCOM PUBLICATIONS — ENVIRONMENT CONFIGURATION (SUPABASE POSTGRESQL)
# ==============================================================================

# Paste your Supabase connection string below.
# You can find this in your Supabase Dashboard:
# -> Project Settings -> Database -> Connection String -> URI (or Connection Pooling URI)
#
# Direct Connection (Port 5432):
# SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Connection Pooler (Port 6543 / Session or Transaction Mode):
# SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

SUPABASE_DATABASE_URL=

# Alternatively, set standard DATABASE_URL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# CORS (Frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
